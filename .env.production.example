# ── VCMS backend — production .env (copy to `.env` on the VM) ────────────────
# Fill in every REPLACE_ME. Never commit the real .env.

NODE_ENV=production

# Container listens on 4000; docker-compose maps it to host 127.0.0.1:5005.
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Host "db" is the docker-compose service name (internal network).
# User/pass/db below must match the POSTGRES_* values further down.
DATABASE_URL="postgresql://vcms:REPLACE_DB_PASSWORD@db:5432/vcms?schema=public"

POSTGRES_USER=vcms
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD   # generate: openssl rand -hex 24
POSTGRES_DB=vcms

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_JWT_SECRET           # generate: openssl rand -hex 32
JWT_EXPIRES_IN=1d

# ── CORS — the exact Vercel frontend origin (no trailing slash) ──────────────
# You can comma-separate multiple (e.g. add a custom domain later).
CORS_ORIGIN=https://REPLACE-vercel-app.vercel.app

# ── File storage (mounted as docker volumes; keep these absolute paths) ──────
UPLOAD_DIR=/data/uploads
GENERATED_DIR=/data/generated
MAX_UPLOAD_MB=10

# ── First-run admin (created idempotently on boot) ───────────────────────────
SEED_ADMIN_EMAIL=admin@email.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=System Admin
