# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://vcms:vcms@localhost:5432/vcms?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Seed admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@email.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="System Admin"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Uploads
MAX_UPLOAD_MB=10

# File storage — "local" (dev, writes under STORAGE_LOCAL_DIR) or "r2" (Cloudflare R2).
# NEVER put real secrets in this file — it is committed to git. Put them in .env.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="storage"
# Required only when STORAGE_DRIVER=r2:
# R2_ACCOUNT_ID=""
# R2_ENDPOINT=""            # or leave blank to derive from R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
